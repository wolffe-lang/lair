//! The decoder's table tests: every control from byte strings, whole and
//! split at every byte, the lone-ESC timeout, the ignored forms, the
//! character keys; and the held-key model from ticks.

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn decode_whole(s: str) -> List[int] {
    var d = new()
    var keys = List[int]()
    feed_all(mut d, bytes_of(s), 1000, mut keys)
    flush(mut d, 1000 + ESC_TIMEOUT_MS, mut keys)
    keys
}

fn decode_split(s: str, at: int) -> List[int] {
    var d = new()
    var keys = List[int]()
    let bs = bytes_of(s)
    var i = 0
    while i < bs.len {
        // The second read arrives 10 ms later: well inside the ESC timeout.
        feed(mut d, bs[i], if i < at then 1000 else 1010, mut keys)
        i += 1
    }
    flush(mut d, 1010 + ESC_TIMEOUT_MS, mut keys)
    keys
}

fn same_keys(a: List[int], b: List[int]) -> bool {
    if a.len != b.len {
        return false
    }
    var i = 0
    while i < a.len {
        if a[i] != b[i] {
            return false
        }
        i += 1
    }
    true
}

fn one(k: int) -> List[int] {
    var v = List[int]()
    (mut v).push(k)
    v
}

fn check(s: str, want: List[int], what: str) {
    let got = decode_whole(s)
    assert(same_keys(got, want), "{what}: whole read gave {got}, want {want}")
    var at = 1
    while at < s.len {
        let split = decode_split(s, at)
        assert(same_keys(split, want), "{what}: split at {at} gave {split}, want {want}")
        at += 1
    }
}

fn test_csi_arrows() {
    check("\x1b[A", one(KEY_UP), "CSI up")
    check("\x1b[B", one(KEY_DOWN), "CSI down")
    check("\x1b[C", one(KEY_RIGHT), "CSI right")
    check("\x1b[D", one(KEY_LEFT), "CSI left")
}

fn test_ss3_arrows() {
    check("\x1bOA", one(KEY_UP), "SS3 up")
    check("\x1bOB", one(KEY_DOWN), "SS3 down")
    check("\x1bOC", one(KEY_RIGHT), "SS3 right")
    check("\x1bOD", one(KEY_LEFT), "SS3 left")
}

fn test_shift_arrows_are_their_own_keys() {
    check("\x1b[1;2B", one(KEY_SHIFT_DOWN), "Shift+Down")
    check("\x1b[1;2A", one(KEY_SHIFT_UP), "Shift+Up")
    check("\x1b[1;2C", one(KEY_SHIFT_RIGHT), "Shift+Right")
    check("\x1b[1;2D", one(KEY_SHIFT_LEFT), "Shift+Left")
}

fn test_other_modifiers_are_the_bare_arrow() {
    check("\x1b[1;3B", one(KEY_DOWN), "Alt+Down")
    check("\x1b[1;5B", one(KEY_DOWN), "Ctrl+Down")
    check("\x1b[1;6B", one(KEY_DOWN), "Shift+Ctrl+Down")
    check("\x1b[1;4B", one(KEY_DOWN), "Shift+Alt+Down")
}

fn test_plain_keys() {
    check(" ", one(KEY_CHAR_BASE + 32), "space is a character key")
    check("z", one(KEY_CHAR_BASE + 122), "z")
    check("Z", one(KEY_CHAR_BASE + 90), "Z")
    check("q", one(KEY_CHAR_BASE + 113), "q")
    check("~", one(KEY_CHAR_BASE + 126), "the last printable byte")
    check("\x03", one(KEY_INTERRUPT), "Ctrl-C")
    check("\r", one(KEY_ENTER), "CR is Enter")
    check("\n", one(KEY_ENTER), "LF is Enter")
    check("\x7f", one(KEY_BACKSPACE), "DEL is Backspace")
    check("\x08", one(KEY_BACKSPACE), "BS is Backspace")
    check("\t", one(KEY_TAB), "Tab")
    check("\x1b[Z", List[int](), "Shift+Tab is recognised and ignored")
    assert(char_of(KEY_CHAR_BASE + 97) == 97, "char_of reads a character back")
    assert(char_of(KEY_ENTER) == -1 && char_of(KEY_UP) == -1, "a key is no character")
    assert(char_key(31) == KEY_NONE && char_key(127) == KEY_NONE, "outside the printable range")
}

fn test_lone_esc_waits_for_the_timeout() {
    var d = new()
    var keys = List[int]()
    feed(mut d, 27 as byte, 500, mut keys)
    flush(mut d, 500 + ESC_TIMEOUT_MS - 1, mut keys)
    assert(keys.len == 0 && esc_pending(d), "not yet")
    assert(esc_deadline_ms(d) == 550, "the deadline is 50 ms after the ESC")
    flush(mut d, 500 + ESC_TIMEOUT_MS, mut keys)
    assert(same_keys(keys, one(KEY_ESC)) && !esc_pending(d), "Esc at the timeout")
}

fn test_esc_then_bracket_late_is_still_a_sequence() {
    // The bracket arrives 40 ms after the ESC: inside the timeout, so the
    // sequence completes and no Esc is guessed.
    var d = new()
    var keys = List[int]()
    feed(mut d, 27 as byte, 0, mut keys)
    flush(mut d, 40, mut keys)
    feed(mut d, 91 as byte, 40, mut keys)
    feed(mut d, 66 as byte, 41, mut keys)
    assert(same_keys(keys, one(KEY_DOWN)), "Down, not Esc then junk: {keys}")
}

fn test_esc_then_plain_byte_is_esc_and_the_byte() {
    var want = List[int]()
    (mut want).push(KEY_ESC)
    (mut want).push(KEY_CHAR_BASE + 32)
    check("\x1b ", want, "Alt+Space")
}

fn test_ignored_forms() {
    var d = new()
    var keys = List[int]()
    feed_all(mut d, bytes_of("\x1b[9999u"), 0, mut keys)
    feed_all(mut d, bytes_of("\x1b[99~"), 0, mut keys)
    feed_all(mut d, bytes_of("\x1b[2;1;3m"), 0, mut keys)
    feed_all(mut d, bytes_of("\x1bOP"), 0, mut keys)
    assert(keys.len == 0, "nothing decoded: {keys}")
    assert(d.ignored == 4, "four ignored: {d.ignored}")
}

fn test_unknown_bytes_are_dropped_and_counted() {
    var d = new()
    var keys = List[int]()
    feed_all(mut d, bytes_of("\x01\x02\x1f"), 0, mut keys)
    assert(keys.len == 0 && d.dropped == 3, "dropped {d.dropped}")
}

fn test_two_sequences_in_one_read() {
    var want = List[int]()
    (mut want).push(KEY_LEFT)
    (mut want).push(KEY_SHIFT_DOWN)
    (mut want).push(KEY_CHAR_BASE + 32)
    check("\x1b[D\x1b[1;2B ", want, "left, Shift+Down, space")
}

fn test_a_tap_holds_for_the_tap_ticks() {
    var h = hold_new()
    hold_press(mut h, 10)
    var n = 0
    var t = 10
    while t < 100 {
        if held(h, t) {
            n += 1
        }
        t += 1
    }
    assert(n == HOLD_TAP_TICKS, "a lone press is held {n} ticks")
}

fn test_a_repeat_run_releases_one_interval_after_the_last_press() {
    var h = hold_new()
    hold_press(mut h, 0)
    // The keyboard's initial delay, then repeats every 2 and 3 ticks.
    hold_press(mut h, 12)
    assert(
        held(h, 12 + HOLD_RATE_MAX) && !held(h, 12 + HOLD_RATE_MAX + HOLD_MARGIN),
        "the first repeat holds the rate's maximum plus the margin",
    )
    var t = 14
    var gap = 2
    while t < 60 {
        hold_press(mut h, t)
        assert(held(h, t + gap), "held through the run at {t}")
        gap = if gap == 2 then 3 else 2
        t += gap
    }
    let last = h.last
    assert(held(h, last + 3), "the measured interval is the larger gap, three")
    assert(
        !held(h, last + 3 + HOLD_MARGIN),
        "released one interval and the margin after the last press",
    )
}

fn test_kitty_printable_low_matrix() { proof_kitty_printable_matrix_every_split(32, 79) }

fn test_kitty_printable_high_matrix() { proof_kitty_printable_matrix_every_split(80, 126) }

fn test_kitty_special_matrix() { proof_kitty_special_matrix_every_split() }

fn test_kitty_functional_matrix() { proof_kitty_functional_matrix_every_split() }

fn test_kitty_defaults_optional_fields_and_refusals() {
    proof_event("\x1b[13u", KEY_ENTER, 0, PRESS)
    proof_event("\x1b[97:65:97;2:2;65u", char_key(97), MOD_SHIFT, REPEAT)
    proof_event("\x1b[97;:3u", char_key(97), 0, RELEASE)
    check("\x1b[13;1:3u", List[int](), "legacy adapter suppresses release")
    proof_event("\x1b[99;5u", char_key(99), MOD_CTRL, PRESS)
    proof_event("\x1b[97;2u", char_key(97), MOD_SHIFT, PRESS)
    for seq in [
        "\x1b[999999999999999999999u",
        "\x1b[13;0u",
        "\x1b[13;257u",
        "\x1b[13;1:4u",
        "\x1b[13;1:0u",
        "\x1b[?11u",
        "\x1b[>11u",
        "\x1b[13;1:1:3u",
    ] {
        check(seq, List[int](), "malformed ignored without overflow")
        var d = new()
        var events = List[Event]()
        events_all(mut d, bytes_of(seq), 0, mut events)
        assert(events.len == 0 && d.ignored == 1, "event decoder rejects malformed sequence")
    }
}

fn apply_stream(mut state: KeyState, text: str, tick: int) {
    var d = new()
    var events = List[Event]()
    events_all(mut d, bytes_of(text), 0, mut events)
    for e in events { update(mut state, e, tick) }
}

fn test_exact_down_resumes_after_left_tap() {
    var state = state_new(true)
    assert(exact(state), "negotiated exact mode")
    apply_stream(mut state, "\x1b[1;1:1B", 0)
    apply_stream(mut state, "\x1b[1;1:1D", 1)
    assert(
        held(key_hold(state, KEY_DOWN), 100) && held(key_hold(state, KEY_LEFT), 100),
        "both held",
    )
    apply_stream(mut state, "\x1b[1;1:3D", 2)
    assert(
        held(key_hold(state, KEY_DOWN), 10000) && !held(key_hold(state, KEY_LEFT), 2),
        "Down resumes",
    )
    apply_stream(mut state, "\x1b[1;1:3B", 3)
    assert(!held(key_hold(state, KEY_DOWN), 3), "Down releases")
}

fn test_exact_diagonal_and_ctrl_across_arrows() {
    var state = state_new(true)
    apply_stream(mut state, "\x1b[57442;5:1u\x1b[1;5:1D\x1b[1;5:1A", 0)
    assert(
        held(key_hold(state, KEY_LEFT), 900) && held(key_hold(state, KEY_UP), 900),
        "Left+Up diagonal",
    )
    apply_stream(mut state, "\x1b[1;5:3A\x1b[1;5:2D", 20)
    assert(
        held(key_hold(state, KEY_LEFT_CTRL), 900) && held(key_hold(state, KEY_CTRL), 900),
        "Ctrl across arrows",
    )
    apply_stream(mut state, "\x1b[57448;5:1u\x1b[57442;5:3u", 21)
    assert(
        !held(key_hold(state, KEY_LEFT_CTRL), 21) &&
            held(key_hold(state, KEY_RIGHT_CTRL), 21) &&
            held(key_hold(state, KEY_CTRL), 21),
        "left/right Control independent",
    )
    apply_stream(mut state, "\x1b[57448;1:3u", 22)
    assert(
        !held(key_hold(state, KEY_CTRL), 22) && held(key_hold(state, KEY_LEFT), 22),
        "release Ctrl only",
    )
    clear(mut state)
    assert(!held(key_hold(state, KEY_LEFT), 22), "clear releases all keys")
}

fn test_registered_key_and_inferred_equivalence() {
    var state = state_new(false)
    register(mut state, char_key(120))
    var old = hold_new()
    for tick in [0, 12, 14, 17, 19, 22] {
        apply_stream(mut state, "x", tick)
        hold_press(mut old, tick)
        register(mut state, char_key(120))
        var now = tick
        while now < tick + 40 {
            assert(
                held(key_hold(state, char_key(120)), now) == held(old, now),
                "same inferred hold",
            )
            now += 1
        }
    }
    assert(!exact(state) && !held(key_hold(state, char_key(121)), 0), "unknown key never held")
    apply_stream(mut state, "\x1b[1;5D", 100)
    assert(
        held(key_hold(state, KEY_CTRL), 101) && !held(key_hold(state, KEY_CTRL), 112),
        "fallback Ctrl expires",
    )
    var precise = state_new(true)
    register(mut precise, char_key(120))
    apply_stream(mut precise, "\x1b[120;1:2u", 0)
    assert(held(key_hold(precise, char_key(120)), 9000), "repeat establishes missing press")
    apply_stream(mut precise, "\x1b[120;1:3u", 1)
    assert(!held(key_hold(precise, char_key(120)), 1), "registered key release")
}
