//! The replay format with a test vocabulary (pack's words): parse,
//! format, round trip, the numeric events, refusals by name.

fn text_of(v: List[byte]) -> str {
    str_from_utf8(v) else "<not utf-8>"
}

fn words() -> Vocab {
    var keys = List[str]()
    for w in "none up down left right parry leap quit interrupt".words() {
        (mut keys).push(w)
    }
    var args = List[str]()
    (mut args).push("health")
    (mut args).push("scent")
    vocab(take keys, take args)
}

fn sample() -> str {
    "# a run\npk 1\nseed 42\ntier rich\nsize 80x24\n\nt 30 up\nt 30 left\nt 95 size 100x30\nt 110 health -25\nt 110 scent 7\nt 120 quit\n"
}

fn test_vocabulary() {
    let v = words()
    assert((key_of(v, "up") else -1) == 1 && (key_of(v, "interrupt") else -1) == 8, "keys by name")
    assert((key_of(v, "none") else -1) == -1, "the no-key has no name")
    assert((key_of(v, "sideways") else -1) == -1, "an unknown name is parse")
    assert(
        key_name(v, 5) == "parry" && key_name(v, 0) == "none" && key_name(v, 99) == "none",
        "names",
    )
    assert(
        (arg_of(v, "health") else -1) == EV_ARG && (arg_of(v, "scent") else -1) == EV_ARG + 1,
        "events",
    )
    assert(arg_name(v, EV_ARG + 1) == "scent" && arg_name(v, EV_ARG + 2) == "none", "event words")
}

fn test_parse_sample() {
    let r = from_text(sample(), words()) else |_| {
        assert(false, "the sample parses")
        new(0, 0, 0, 0)
    }
    assert(r.seed == 42 && r.tier == 1 && r.cols == 80 && r.rows == 24, "header")
    assert(r.events.len == 6 && last_tick(r) == 120, "events")
    var keys = List[int]()
    let (c, rows, h) = at(r, 30, mut keys)
    assert(
        keys.len == 2 && keys[0] == 1 && keys[1] == 3 && c == 0 && rows == 0 && h == 0,
        "tick 30: up, left",
    )
    var k2 = List[int]()
    let (c2, r2, h2) = at(r, 95, mut k2)
    assert(k2.len == 0 && c2 == 100 && r2 == 30 && h2 == 0, "tick 95: a resize")
    var k3 = List[int]()
    let (c3, _, h3) = at(r, 110, mut k3)
    assert(k3.len == 0 && c3 == 0 && h3 == -25, "tick 110: health -25, the first event kind")
    assert(
        args_at(r, 110, 1) == 7 && args_at(r, 110, 0) == -25 && args_at(r, 30, 1) == 0,
        "args_at by kind",
    )
}

fn test_round_trip() {
    let v = words()
    let r = from_text(sample(), v) else new(0, 0, 0, 0)
    var out = List[byte]()
    format(r, v, mut out)
    let again = from_text(text_of(out), v) else new(0, 0, 0, 0)
    var out2 = List[byte]()
    format(again, v, mut out2)
    assert(text_of(out) == text_of(out2), "format is a fixed point:\n{text_of(out)}")
    assert(
        text_of(out) ==
            "pk 1\nseed 42\ntier rich\nsize 80x24\nt 30 up\nt 30 left\nt 95 size 100x30\nt 110 health -25\nt 110 scent 7\nt 120 quit\n",
        "{text_of(out)}",
    )
}

fn refused(text: str) -> bool {
    var bad = false
    let _ = from_text(text, words()) else |_| {
        bad = true
        new(0, 0, 0, 0)
    }
    bad
}

fn test_refusals() {
    assert(refused("pk 2\nseed 1\ntier rich\nsize 80x24\n"), "version 2")
    assert(refused("seed 1\ntier rich\nsize 80x24\n"), "no version")
    assert(refused("pk 1\nseed 1\ntier vivid\nsize 80x24\n"), "unknown tier")
    assert(refused("pk 1\nseed 1\ntier rich\nsize 80\n"), "bad size")
    assert(refused("pk 1\nseed 1\ntier rich\nsize 80x24\nt 10 up\nt 5 up\n"), "ticks backwards")
    assert(refused("pk 1\nseed 1\ntier rich\nsize 80x24\nt 10 sideways\n"), "unknown key")
    assert(refused("pk 1\nseed 1\ntier rich\nsize 80x24\nwolves 5\n"), "unknown word")
    assert(refused("pk 1\nseed 1\ntier rich\nsize 80x24\nt 10 health\n"), "health without a number")
    assert(refused("pk 1\nseed 1\ntier rich\nsize 80x24\nt 10 health ten\n"), "health with a word")
    assert(!refused("pk 1\nseed -7\ntier plain\nsize 20x10\n"), "a negative seed is a seed")
}

fn test_parse_size() {
    let (c, r) = parse_size("200x60") else (0, 0)
    assert(c == 200 && r == 60, "200x60")
    var bad = false
    let _ = parse_size("0x5") else |_| {
        bad = true
        (0, 0)
    }
    assert(bad, "a zero dimension is parse")
}

fn test_start_is_read_written_and_defaults_to_zero() {
    let v = words()
    let r = from_text("pk 1\nseed 3\ntier plain\nsize 80x24\nstart 1200\nt 5 up\n", v) else {
        assert(false, "parses")
        return
    }
    assert(r.start == 1200, "start {r.start}")
    var out = List[byte]()
    format(r, v, mut out)
    let text = str_from_utf8(out) else ""
    assert(text.contains("\nstart 1200\n"), "written back: {text}")
    let plain = from_text("pk 1\nseed 3\ntier plain\nsize 80x24\n", v) else {
        assert(false, "parses")
        return
    }
    assert(plain.start == 0, "no line: zero")
    var out2 = List[byte]()
    format(plain, v, mut out2)
    assert(!(str_from_utf8(out2) else "x").contains("start"), "a zero start is not written")
    let bad = from_text("pk 1\nseed 3\ntier plain\nsize 80x24\nstart -4\n", v) else {
        return
    }
    assert(false, "a negative start is a parse failure: {bad.start}")
}

fn test_the_score_comment_is_written_read_and_optional() {
    let v = words()
    let r = from_text(sample(), v) else new(0, 0, 0, 0)
    var out = List[byte]()
    format_scored(r, v, 1234, mut out)
    let text = text_of(out)
    assert(text.contains("\n# score 1234\n"), "the comment after the header: {text}")
    assert((score_of(text) else -1) == 1234, "read back")
    let again = from_text(text, v) else new(0, 0, 0, 0)
    assert(
        again.events.len == r.events.len && again.seed == 42,
        "the comment is ignored by the parser",
    )
    assert((score_of(sample()) else -1) == -1, "no comment, none")
    assert((score_of("# score x\n") else -1) == -1, "a bad number, none")
}
