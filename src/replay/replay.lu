//! replay — the `.pk` file (`docs/REPLAY.md`): a run as a seed, a tier, a
//! size and timestamped inputs, enough to reproduce it exactly (pack's
//! campaign innovation 1). The same text is a headless script.
//! Line-oriented, plain text, one fact a line:
//!
//!     pk 1
//!     seed 42
//!     tier rich
//!     size 80x24
//!     start 600
//!     t 30 up
//!     t 95 size 100x30
//!     t 120 health -25
//!
//! `pk 1` is the version; `start N` (optional) begins the run N units up
//! the world (pack: rows up the path), the same world. Events are `t TICK
//! KEY` (a key by the game's name for it), `t TICK size WxH` (a resize) or
//! `t TICK WORD N` (a numeric event the game names: pack's `health`, the
//! goldens' and the debug keys' channel), ticks non-decreasing. A blank
//! line or one starting `#` is ignored; `# score N` is read by `score_of`.
//! `parse` names a line that is none of these (the parser's row carries
//! nothing more: the file is small and a reader reads it).
//!
//! The key and event words are the game's **vocabulary** (`Vocab`): the
//! engine stores a key as the number the game gives it, so the simulation
//! reads the file's keys as its own. pack's vocabulary is `up down left
//! right parry leap quit interrupt` (keys 1 to 8) and `health`; cub's is
//! its own. The module imports nothing but the prelude.

/// A resize event's key (no key); `cols` and `rows` carry the size.
pub const EV_SIZE: int = 0

/// The first numeric event's key: `EV_ARG + i` is the vocabulary's `i`th
/// event word, its value in `arg`. Keys a game numbers stay under it.
pub const EV_ARG: int = 100

/// A game's words: `keys[k]` is the name of key `k` (index 0 is the
/// no-key, never written), `args[i]` the word of numeric event `EV_ARG + i`.
pub struct Vocab {
    keys: List[str],
    args: List[str],
}

/// A vocabulary from its two lists (taken: the game builds them once).
pub fn vocab(take keys: List[str], take args: List[str]) -> Vocab {
    Vocab { keys: keys, args: args }
}

/// The key number a name means in `v`; `parse` for a name that is none
/// (index 0, the no-key, is none too).
pub fn key_of(v: Vocab, name: str) -> int ! {parse} {
    var k = 1
    while k < v.keys.len {
        if v.keys[k] == name {
            return k
        }
        k += 1
    }
    parse
}

/// The name of key `k` in `v`, or `none` for a number outside it.
pub fn key_name(v: Vocab, k: int) -> str {
    if k >= 1 && k < v.keys.len then v.keys[k] else "none"
}

/// The event key a numeric event's word means in `v`; `parse` for none.
pub fn arg_of(v: Vocab, word: str) -> int ! {parse} {
    var i = 0
    while i < v.args.len {
        if v.args[i] == word {
            return EV_ARG + i
        }
        i += 1
    }
    parse
}

/// The word of numeric event key `k` in `v`, or `none`.
pub fn arg_name(v: Vocab, k: int) -> str {
    let i = k - EV_ARG
    if i >= 0 && i < v.args.len then v.args[i] else "none"
}

/// One event: at `tick`, a key (as the game numbers them); with `key`
/// `EV_SIZE`, a resize to `cols` by `rows`; with `EV_ARG + i`, the value
/// `arg` of the game's `i`th numeric event.
pub struct Event {
    tick: int,
    key: int,
    cols: int,
    rows: int,
    arg: int,
}

/// A replay: the header (the seed, the tier, the size, and `start`, 0
/// unless the file says `start N`) and the events.
pub struct Replay {
    seed: int,
    tier: int,
    cols: int,
    rows: int,
    start: int,
    events: List[Event],
}

/// An empty replay with the given header, starting at 0.
pub fn new(seed: int, tier: int, cols: int, rows: int) -> Replay {
    Replay { seed: seed, tier: tier, cols: cols, rows: rows, start: 0, events: List[Event]() }
}

/// Record a key at a tick.
pub fn push_key(mut r: Replay, tick: int, key: int) {
    (mut r.events).push(Event { tick: tick, key: key, cols: 0, rows: 0, arg: 0 })
}

/// Record a resize at a tick.
pub fn push_size(mut r: Replay, tick: int, cols: int, rows: int) {
    (mut r.events).push(Event { tick: tick, key: EV_SIZE, cols: cols, rows: rows, arg: 0 })
}

/// Record the game's `i`th numeric event with `value` at a tick.
pub fn push_arg(mut r: Replay, tick: int, i: int, value: int) {
    (mut r.events).push(Event { tick: tick, key: EV_ARG + i, cols: 0, rows: 0, arg: value })
}

/// The keys at `tick`, pushed onto `keys` in file order; the last resize
/// at that tick as `(cols, rows)`, or `(0, 0)` when none; the values of
/// the game's FIRST numeric event (`EV_ARG`) at that tick summed (pack's
/// health). Another event kind is read with `args_at`.
pub fn at(r: Replay, tick: int, mut keys: List[int]) -> (int, int, int) {
    var cols = 0
    var rows = 0
    var sum = 0
    for e in r.events {
        if e.tick == tick {
            if e.key == EV_SIZE {
                cols = e.cols
                rows = e.rows
            } else if e.key == EV_ARG {
                sum += e.arg
            } else if e.key < EV_ARG {
                (mut keys).push(e.key)
            }
        }
    }
    (cols, rows, sum)
}

/// The values of numeric event `EV_ARG + i` at `tick`, summed.
pub fn args_at(r: Replay, tick: int, i: int) -> int {
    var sum = 0
    for e in r.events {
        if e.tick == tick && e.key == EV_ARG + i {
            sum += e.arg
        }
    }
    sum
}

/// The last tick any event names (0 for none).
pub fn last_tick(r: Replay) -> int {
    var t = 0
    for e in r.events {
        if e.tick > t {
            t = e.tick
        }
    }
    t
}

/// Parse `WxH`.
pub fn parse_size(s: str) -> (int, int) ! {parse} {
    let (w, h) = s.split_once("x") else |_| {
        return parse
    }
    let cols = w.trim().to_int()?
    let rows = h.trim().to_int()?
    if cols < 1 || rows < 1 {
        return parse
    }
    (cols, rows)
}

/// Read a `.pk` text with the game's vocabulary. `parse` for a missing
/// header line, an unknown word, a bad number, a tick that goes
/// backwards, or a version that is not 1.
pub fn from_text(text: str, v: Vocab) -> Replay ! {parse} {
    var r = new(0, 0, 0, 0)
    var have_version = false
    var have_seed = false
    var have_tier = false
    var have_size = false
    var last = 0
    for raw in text.lines() {
        let line = raw.trim()
        if line.len == 0 || line.starts_with("#") {
            continue
        }
        let words = line.words()
        if words.len < 2 {
            return parse
        }
        let w0 = words[0]
        if w0 == "pk" {
            if words[1] != "1" {
                return parse
            }
            have_version = true
        } else if w0 == "seed" {
            r.seed = words[1].to_int()?
            have_seed = true
        } else if w0 == "tier" {
            if words[1] == "rich" {
                r.tier = 1
            } else if words[1] == "plain" {
                r.tier = 0
            } else {
                return parse
            }
            have_tier = true
        } else if w0 == "size" {
            let (c, rows) = parse_size(words[1])?
            r.cols = c
            r.rows = rows
            have_size = true
        } else if w0 == "start" {
            let st = words[1].to_int()?
            if st < 0 {
                return parse
            }
            r.start = st
        } else if w0 == "t" {
            if words.len < 3 {
                return parse
            }
            let tick = words[1].to_int()?
            if tick < last || tick < 0 {
                return parse
            }
            last = tick
            if words[2] == "size" {
                if words.len < 4 {
                    return parse
                }
                let (c, rows) = parse_size(words[3])?
                push_size(mut r, tick, c, rows)
            } else {
                let ev = arg_of(v, words[2]) else -1
                if ev >= 0 {
                    if words.len < 4 {
                        return parse
                    }
                    push_arg(mut r, tick, ev - EV_ARG, words[3].to_int()?)
                } else {
                    push_key(mut r, tick, key_of(v, words[2])?)
                }
            }
        } else {
            return parse
        }
    }
    if !have_version || !have_seed || !have_tier || !have_size {
        return parse
    }
    r
}

fn push_str(mut out: List[byte], s: str) {
    for b in s.bytes() {
        (mut out).push(b)
    }
}

fn format_header(r: Replay, mut out: List[byte]) {
    push_str(mut out, "pk 1\n")
    push_str(mut out, "seed {r.seed}\n")
    push_str(mut out, "tier {if r.tier == 1 then "rich" else "plain"}\n")
    push_str(mut out, "size {r.cols}x{r.rows}\n")
    if r.start != 0 {
        push_str(mut out, "start {r.start}\n")
    }
}

fn format_events(r: Replay, v: Vocab, mut out: List[byte]) {
    for e in r.events {
        if e.key == EV_SIZE {
            push_str(mut out, "t {e.tick} size {e.cols}x{e.rows}\n")
        } else if e.key >= EV_ARG {
            push_str(mut out, "t {e.tick} {arg_name(v, e.key)} {e.arg}\n")
        } else {
            push_str(mut out, "t {e.tick} {key_name(v, e.key)}\n")
        }
    }
}

/// The `.pk` text of `r`, as bytes, with the game's words.
pub fn format(r: Replay, v: Vocab, mut out: List[byte]) {
    format_header(r, mut out)
    format_events(r, v, mut out)
}

/// The score a `.pk` text carries in its `# score N` comment (pack's
/// pk03: the card writes it when `s` saves; the title reads it and a
/// re-run verifies it), or `none` when the file has no such line.
pub fn score_of(text: str) -> int ! {none} {
    for raw in text.lines() {
        let line = raw.trim()
        if line.starts_with("# score ") {
            let words = line.words()
            if words.len >= 3 {
                return words[2].to_int() else {
                    return none
                }
            }
        }
    }
    none
}

/// The `.pk` text of `r` with a `# score N` comment after the header (a
/// reader ignores the comment; `score_of` reads it).
pub fn format_scored(r: Replay, v: Vocab, score: int, mut out: List[byte]) {
    format_header(r, mut out)
    push_str(mut out, "# score {score}\n")
    format_events(r, v, mut out)
}
