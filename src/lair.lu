//! lair — the wolf games' engine, and its own small binary: the engine's
//! self-test on the tier that ships, the terminal model as a tool, the
//! version. The games (`pack`, `cub`) are their own programs on these
//! modules: grid, tier, draw, term, input, clock, replay, world, headless,
//! probe (`docs/ENGINE.md` says what is engine and what is game).
//!
//! Track 19 of the wolffe-lang planning repo: pack's pk00 wrote the
//! engine, pk01 to pk03 grew it with the game, cb00 extracted it here.

use headless
use input
use replay
use std.env
use std.fs

fn usage_text() -> str {
    "lair — the wolf games' engine\n\n" +
        "  lair --selftest                   the decoder table (whole and split at every byte) and\n" +
        "                                    the diff property, on THIS binary\n" +
        "  lair --apply CAPTURE --size WxH   a captured byte stream as a frame, through the terminal model\n" +
        "  lair --version\n"
}

fn bytes_of(s: str) -> List[byte] {
    var v = List[byte]()
    for b in s.bytes() {
        (mut v).push(b)
    }
    v
}

fn decode_all(s: str, split_at: int) -> List[int] {
    var d = input.new()
    var keys = List[int]()
    let bs = bytes_of(s)
    var i = 0
    while i < bs.len {
        input.feed(mut d, bs[i], if i < split_at then 1000 else 1010, mut keys)
        i += 1
    }
    input.flush(mut d, 1010 + input.ESC_TIMEOUT_MS, mut keys)
    keys
}

fn keys_text(keys: List[int]) -> str {
    var t = ""
    for k in keys {
        t = "{t} {k}"
    }
    t
}

fn describe(seq: str) -> str {
    var t = ""
    for b in seq.bytes() {
        t = "{t} {b as int}"
    }
    "bytes{t}"
}

/// `--selftest`: the decoder's table (every terminal key, whole and split
/// at every byte) and the diff property, run on THIS binary, the tier that
/// ships. The unit tests run on the checked machine; wolf 0.2.35's release
/// tier miscompiled pack's decoder while they passed, which is why a
/// shipped binary is held to the table here. Exit 1 on any mismatch.
fn run_selftest() -> int {
    var bad = 0
    // Each row: the bytes, `|`, the keys wanted (space separated).
    var rows = List[str]()
    (mut rows).push("\x1b[A|1")
    (mut rows).push("\x1b[B|2")
    (mut rows).push("\x1b[C|4")
    (mut rows).push("\x1b[D|3")
    (mut rows).push("\x1bOA|1")
    (mut rows).push("\x1bOB|2")
    (mut rows).push("\x1b[1;2A|5")
    (mut rows).push("\x1b[1;2B|6")
    (mut rows).push("\x1b[1;2D|7")
    (mut rows).push("\x1b[1;2C|8")
    (mut rows).push("\x1b[1;5B|2")
    (mut rows).push(" |1032")
    (mut rows).push("z|1122")
    (mut rows).push("q|1113")
    (mut rows).push("\x03|10")
    (mut rows).push("\r|11")
    (mut rows).push("\x7f|12")
    (mut rows).push("\x1b|9")
    (mut rows).push("\x1b |9 1032")
    (mut rows).push("\x1b[57;2u|")
    (mut rows).push("\x1b[5~|")
    (mut rows).push("\x1b[D\x1b[1;2B |3 6 1032")
    for row in rows {
        let (seq, want_raw) = row.split_once("|") else (row, "")
        let want = if want_raw.len == 0 then "" else " {want_raw}"
        var at = 0
        while at <= seq.len {
            let got = keys_text(decode_all(seq, at))
            if got != want {
                print("selftest: decoder: {describe(seq)} split at {at}: got{got}, want{want}")
                bad += 1
            }
            at += 1
        }
    }
    bad += headless.diff_property()
    if bad == 0 {
        print(
            "selftest: ok (the decoder table whole and split at every byte; the diff property over 12 frames)",
        )
        return 0
    }
    print("selftest: {bad} FAILED")
    1
}

fn run_apply(path: str, size: str) -> int {
    let (cols, rows) = replay.parse_size(size) else |_| {
        eprint("lair: --apply needs --size WxH")
        return 2
    }
    let bytes = fs.read_bytes(path) else |_| {
        eprint("lair: cannot read {path}")
        return 2
    }
    var tout = fs.stdout()
    fs.write_chunk(mut tout, headless.apply(bytes, cols, rows)) else |_| {
        return 2
    }
    0
}

fn main() -> int {
    let args = env.args()
    var apply_path = ""
    var size = ""
    var i = 0
    while i < args.len {
        let a = args[i]
        let more = i + 1 < args.len
        if a == "--selftest" {
            return run_selftest()
        } else if a == "--version" {
            print("lair 0.1.0 (cb00: the engine extracted from pack)")
            return 0
        } else if a == "--help" || a == "-h" {
            print(usage_text())
            return 0
        } else if more && a == "--apply" {
            i += 1
            apply_path = args[i]
        } else if more && a == "--size" {
            i += 1
            size = args[i]
        } else {
            eprint(usage_text())
            return 2
        }
        i += 1
    }
    if apply_path != "" {
        return run_apply(apply_path, size)
    }
    eprint(usage_text())
    2
}
