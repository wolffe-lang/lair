//! term — the terminal layer: raw mode and the alternate screen through
//! `std.term`, the restore on every exit path, the size and its change,
//! the refusals by name. The one module that touches the terminal.
//!
//! **Restore on every exit path** (campaign rule 4). The runtime's
//! `restore_at_exit` is registered BEFORE the first byte is written and
//! before the mode changes, with the saved mode and the leave bytes (the
//! alternate screen left, the cursor shown, the attributes reset), so a
//! return from `main`, an error row, `os_exit` and a trap all restore in
//! the runtime, with no code of the game's running (`[os.term.restore]`). The
//! signals a terminal sends — Ctrl-C's interrupt, a TERM, a HUP, a QUIT —
//! are listened for and end the loop, which restores through `leave` and
//! then `main`'s return. Only a death nobody can listen for (KILL, a fault
//! outside the stack guard) restores nothing; the pty runner measures the
//! three paths pack's contract named (`q`, SIGINT, a trap).
//!
//! The restore is registered on **standard output**: the runtime writes
//! the leave bytes through a duplicate of the handle it is given, and a
//! program started as `game < /dev/tty` has a read-only descriptor 0,
//! where the write would fail silently (measured by pack's pk00 probe
//! under the pty runner). The mode is read and set through the same handle;
//! both name one terminal.
//!
//! **Refusals by name**: `not_tty` when either standard stream is not a
//! terminal, `dumb` for `TERM=dumb`, `small` for a window under the
//! minimum (R-PK-6: 80 by 24; the field scales up, never down), `io` for
//! a terminal that refuses its mode. `message` gives each its sentence.

use clock
use std.env
use std.fs
use std.io as std_io
use std.signal
use std.term as std_term

/// The minimum columns (pack's R-pk00-1 A, = R-PK-6; cub's R-CB-5
/// recommends the same).
pub const MIN_COLS: int = 80

/// The minimum rows.
pub const MIN_ROWS: int = 24

/// The terminal: the saved mode, whether raw mode and the alternate
/// screen are on, the size, the environment's say on the tier.
pub struct Term {
    saved: std_term.Mode,
    raw: bool,
    alt: bool,
    rows: int,
    cols: int,
    truecolor: bool,
    term_name: str,
}

/// Why the terminal was refused.
error OpenErrors = {not_tty, dumb, small, io}

/// A key read's rows: the end of input (a hang-up) or the host's failure.
error ReadErrors = {eof, io}

/// The sentence for a refusal, for standard error, in the program's
/// name (`prog`: the game's).
pub fn message(e: str, prog: str) -> str {
    if e == "not_tty" {
        return "{prog}: standard input and output must be a terminal (try: {prog} --headless)"
    }
    if e == "dumb" {
        return "{prog}: TERM=dumb cannot draw the forest"
    }
    if e == "small" {
        return "{prog}: the terminal is smaller than {MIN_COLS}x{MIN_ROWS}; enlarge it"
    }
    "{prog}: the terminal refused its mode"
}

/// The bytes that enter the alternate screen and hide the cursor.
pub fn enter_bytes() -> str {
    "\x1b[?1049h\x1b[?25l\x1b[H\x1b[2J"
}

/// The bytes that leave it: attributes reset, cursor shown, main screen.
pub fn leave_bytes() -> str {
    "\x1b[0m\x1b[?25h\x1b[?1049l"
}

/// Open the terminal: both standard streams must be terminals, `TERM`
/// not dumb, the size at least the minimum. Nothing is changed yet.
pub fn open() -> Term ! OpenErrors {
    let tin = fs.stdin()
    let tout = fs.stdout()
    let in_tty = std_io.is_terminal(tin) else false
    let out_tty = std_io.is_terminal(tout) else false
    if !in_tty || !out_tty {
        return not_tty
    }
    let term_name = env.get("TERM") else ""
    if term_name == "dumb" {
        return dumb
    }
    let saved = std_term.mode(tout) else |_| {
        return io
    }
    let size = std_term.size(tout) else |_| {
        return io
    }
    var rows = size.rows
    var cols = size.columns
    if rows == 0 || cols == 0 {
        // A pseudo-terminal nobody sized: the classic default.
        rows = 24
        cols = 80
    }
    if rows < MIN_ROWS || cols < MIN_COLS {
        return small
    }
    Term {
        saved: saved,
        raw: false,
        alt: false,
        rows: rows,
        cols: cols,
        truecolor: false,
        term_name: term_name,
    }
}

/// The meanings the loop listens for: the window's size, and the four
/// deaths a terminal or a shell sends that the loop ends cleanly on.
pub fn signal_set() -> int {
    signal.resize() | signal.interrupt() | signal.terminate() | signal.reload() | signal.quit()
}

/// Enter: register the restore (the saved mode and `leave_bytes`), listen
/// for the signals, set raw mode (signals kept: Ctrl-C arrives as the
/// interrupt meaning, never as a byte), write the enter bytes.
pub fn enter(mut t: Term) -> () ! {io} {
    var tout = fs.stdout()
    var leave = List[byte]()
    for b in leave_bytes().bytes() {
        (mut leave).push(b)
    }
    std_term.restore_at_exit(tout, t.saved, leave) else |_| {
        return io
    }
    signal.listen(signal_set()) else |_| {
        return io
    }
    var raw = std_term.raw_bytes(t.saved)
    raw.signals = true
    std_term.set_mode(tout, raw) else |_| {
        return io
    }
    t.raw = true
    var enter = List[byte]()
    for b in enter_bytes().bytes() {
        (mut enter).push(b)
    }
    fs.write_chunk(mut tout, enter) else |_| {
        return io
    }
    t.alt = true
}

/// Leave: the leave bytes, the saved mode back, the registration
/// re-armed with no bytes (so the runtime's restore at `main`'s return
/// writes nothing twice). Idempotent.
pub fn leave(mut t: Term) {
    if !t.alt && !t.raw {
        return
    }
    var tout = fs.stdout()
    var leave = List[byte]()
    for b in leave_bytes().bytes() {
        (mut leave).push(b)
    }
    fs.write_chunk(mut tout, leave) else |_| {}
    std_term.set_mode(tout, t.saved) else |_| {}
    std_term.restore_at_exit(tout, t.saved, List[byte]()) else |_| {}
    t.alt = false
    t.raw = false
}

/// Re-read the size after a resize; true when it changed. A size under
/// the minimum is kept as the minimum (the field never shrinks below it;
/// the terminal clips).
pub fn resize(mut t: Term) -> bool {
    let size = std_term.size(fs.stdout()) else |_| {
        return false
    }
    var rows = size.rows
    var cols = size.columns
    if rows < MIN_ROWS {
        rows = MIN_ROWS
    }
    if cols < MIN_COLS {
        cols = MIN_COLS
    }
    if rows == t.rows && cols == t.cols {
        return false
    }
    t.rows = rows
    t.cols = cols
    true
}

/// Write a frame's bytes to the terminal.
pub fn write(bytes: List[byte]) -> () ! {io} {
    var tout = fs.stdout()
    fs.write_chunk(mut tout, bytes) else |_| {
        return io
    }
}

/// Read what standard input has, after a wait said it is ready: at most
/// `max` bytes, as a fresh list in the caller's region (a key event is a
/// few bytes; the ambient region holds them for the game's life, which is
/// kilobytes an hour). `eof` at a hang-up.
pub fn read_keys(max: int) -> List[byte] ! ReadErrors {
    var tin = fs.stdin()
    fs.read_chunk(mut tin, max)?
}

/// Bounded support query: unsupported terminals never stall startup.
pub const QUERY_TIMEOUT_MS: int = 150

/// An opt-in keyboard session. Keep Term's layout for older games.
pub struct Session {
    terminal: Term,
    keyboard: bool,
    startup: List[byte],
}

/// Support query and the exact enhancements required for key-up events.
pub fn query_bytes() -> str { "\x1b[?u" }

/// Push exactly disambiguation, event types and all keys.
pub fn push_bytes() -> str { "\x1b[>11u" }

/// Restore the previous keyboard flags on the current screen.
pub fn pop_bytes() -> str { "\x1b[<u" }

fn byte_list(s: str) -> List[byte] {
    var out = List[byte]()
    for b in s.bytes() { (mut out).push(b) }
    out
}

/// Remove one complete support answer, preserving all surrounding input.
/// Only decimal flags are accepted, bounded before multiplication.
pub fn take_answer(mut bytes: List[byte]) -> bool {
    var start = 0
    while start + 4 < bytes.len {
        if bytes[start] as int == 27 &&
            bytes[start + 1] as int == 91 &&
            bytes[start + 2] as int == 63 {
            var i = start + 3
            var digits = 0
            while i < bytes.len && bytes[i] as int >= 48 && bytes[i] as int <= 57 && digits < 9 {
                i += 1
                digits += 1
            }
            if digits > 0 && i < bytes.len && bytes[i] as int == 117 {
                var keep = List[byte]()
                var n = 0
                while n < bytes.len {
                    if n < start || n > i { (mut keep).push(bytes[n]) }
                    n += 1
                }
                bytes = keep
                return true
            }
        }
        start += 1
    }
    false
}

fn negotiate(mut s: Session) -> () ! {io} {
    write(byte_list(query_bytes()))?
    let deadline = clock.now_ns() + QUERY_TIMEOUT_MS * 1000000
    var timer = clock.new(clock.now_ns())
    while clock.now_ns() < deadline && s.startup.len < 4096 {
        let wake = clock.wait_until(mut timer, deadline, signal_set())?
        if wake.meaning &
            (signal.interrupt() | signal.terminate() | signal.reload() | signal.quit()) !=
            0 {
            return io
        }
        if wake.input_ready {
            let bytes = read_keys(256) else |_| { return io }
            for b in bytes { (mut s.startup).push(b) }
            if take_answer(mut s.startup) {
                // The alternate screen has its own protocol stack. The pop
                // must run BEFORE leaving it, even when the runtime traps.
                std_term.restore_at_exit(
                    fs.stdout(),
                    s.terminal.saved,
                    byte_list(pop_bytes() + leave_bytes()),
                ) else |_| { return io }
                s.keyboard = true
                write(byte_list(push_bytes()))?
                return
            }
        }
    }
}

/// Open, enter and negotiate. Existing open/enter users remain legacy-only.
pub fn open_input() -> Session ! OpenErrors {
    var terminal = open()?
    enter(mut terminal) else |_| { leave(mut terminal); return io }
    var s = Session { terminal: terminal, keyboard: false, startup: List[byte]() }
    negotiate(mut s) else |_| { close_input(mut s); return io }
    s
}

/// Idempotent normal/error cleanup; runtime registration covers crash/exit.
pub fn close_input(mut s: Session) {
    if s.keyboard {
        write(byte_list(pop_bytes())) else |_| {}
        s.keyboard = false
    }
    leave(mut s.terminal)
}

/// A bounded real-terminal witness used by tools/input-check.
pub fn witness(mode: str) -> int {
    if mode == "legacy" {
        var t = open() else |_| { return 2 }
        enter(mut t) else |_| { leave(mut t); return 2 }
        leave(mut t)
        return 0
    }
    var s = open_input() else |_| { return 2 }
    eprint("input-ready exact={s.keyboard} startup={s.startup.len}")
    if mode == "crash" { assert(false, "input crash witness") }
    if mode == "error" { close_input(mut s); return 2 }
    var timer = clock.new(clock.now_ns())
    let deadline = clock.now_ns() + 2000000000
    while clock.now_ns() < deadline {
        let wake = clock.wait_until(mut timer, deadline, signal_set()) else |_| { break }
        if wake.meaning & signal.interrupt() != 0 { break }
        if wake.input_ready {
            let bytes = read_keys(256) else |_| { break }
            var quit = false
            for b in bytes { if b as int == 113 { quit = true } }
            if quit { break }
        }
    }
    close_input(mut s)
    close_input(mut s)
    0
}
