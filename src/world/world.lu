//! world — the forest from seeded noise (pack's campaign innovation 3).
//! Every question about the world is a pure function of the seed and a
//! world coordinate, so any row can be asked at any time (a resize asks for
//! rows never seen), nothing is stored, and the same seed is the same
//! forest on every machine.
//!
//! Positions are fixed-point: `FP` units a cell. Channels of 1-D value
//! noise run along the world's rows: lattice points every `LATTICE` rows
//! take a hashed value, and rows between take a smoothstep blend. The
//! texture of the forest and of the ground at a cell is a hash of the cell.
//!
//! The forest's **density** is channel `DENSITY_CHANNEL` of that noise:
//! under `DENSITY_CLEARING` a clearing (grass to the verge, the odd
//! trunk), under `DENSITY_STAND` thin woods, above it a dense stand, and
//! `forest_kind` draws the cover from it. What a game lays over the
//! forest is its own: pack's path (its centre and half width from channels
//! 1 and 2), its spawn and deer rates; cub's areas. Those read the noise
//! through `noise`, `hash` and `density` here.

/// Fixed-point units a cell.
pub const FP: int = 256

/// Rows between noise lattice points: the path bends over this scale
/// (about two seconds of trot).
pub const LATTICE: int = 64

/// A 64-bit mix of two words: the one hash the world uses.
fn mix(a: int, b: int) -> wrapping[u64] {
    let m1: wrapping[u64] = 11400714819323198485
    let m2: wrapping[u64] = 14029467366897019727
    let s: wrapping[u64] = 7046029254386353087
    var h: wrapping[u64] = a as wrapping[u64] * m1 + s
    h = h ^ h >> 29
    h = (h + b as wrapping[u64]) * m2
    h = h ^ h >> 32
    h = h * m1
    h ^ h >> 29
}

/// A hash of `(seed, a, b)` in `[0, n)`; `n` above 0.
pub fn hash(seed: int, a: int, b: int, n: int) -> int {
    let h = mix(seed * 7919 + a, b * 104729 + a)
    let mask: wrapping[u64] = 2147483647
    (h >> 11 & mask) as int % n
}

/// Noise in `[0, FP]` at `row` on channel `ch`: value noise with a
/// smoothstep blend between lattice points.
pub fn noise(seed: int, ch: int, row: int) -> int {
    var k = row / LATTICE
    var r = row - k * LATTICE
    if r < 0 {
        r += LATTICE
        k -= 1
    }
    let a = hash(seed, ch, k, FP + 1)
    let b = hash(seed, ch, k + 1, FP + 1)
    // smoothstep t*t*(3-2t) over t in [0,1], both t and the result in FP.
    let t = r * FP / LATTICE
    let s = t * t / FP * (3 * FP - 2 * t) / FP
    a + (b - a) * s / FP
}

/// The noise channel the density reads.
pub const DENSITY_CHANNEL: int = 3

/// Density below this is a clearing.
pub const DENSITY_CLEARING: int = 72

/// Density at or above this is a dense stand; between is thin woods.
pub const DENSITY_STAND: int = 168

/// The forest's density at `row`, in `[0, FP]`: the third channel of the
/// path's noise, so a clearing and the bend it sits in come from one seed.
pub fn density(seed: int, row: int) -> int {
    noise(seed, DENSITY_CHANNEL, row)
}

/// A clearing, thin woods or a dense stand at `row`: 0, 1 or 2.
pub fn density_band(seed: int, row: int) -> int {
    let d = density(seed, row)
    if d < DENSITY_CLEARING {
        return 0
    }
    if d < DENSITY_STAND {
        return 1
    }
    2
}

/// The sprite kind at a cell outside the path: 0 grass (the verge, within
/// a cell of the edge), 1 trunk, 2 canopy, 3 deep forest. The cover rises
/// with distance from the path; `density` (`[0, FP]`, the row's) picks
/// the band: a clearing is grass with the odd trunk, and both thin woods
/// and a dense stand draw the woods' foliage (canopy that opens near the
/// path), the stand with more trunks (the maintainer's word, 2026-10-25).
pub fn forest_kind(seed: int, row: int, col: int, dist_cells: int, density: int) -> int {
    if dist_cells <= 0 {
        return 0
    }
    let h = hash(seed, row, col, 100)
    if density < DENSITY_CLEARING {
        return if h < 3 then 1 else if h < 8 then 2 else 0
    }
    // Thin woods and a dense stand draw ONE foliage texture, the woods':
    // the maintainer's word from play (2026-10-25, a screenshot of pk01's
    // build): the stand's own texture (canopy from the verge, deep forest
    // three cells in) read as dense horizontal bands of dots, "less than
    // optimal" against the varied foliage the run starts with, so the
    // starting texture is kept for the duration of the run. Density keeps
    // its other effects (the path's width, the spawn rate) and a stand
    // still thickens by its trunks alone.
    let trunk = if density < DENSITY_STAND then 0 else 4
    if dist_cells <= 2 {
        return if h < 12 + trunk then 1 else if h < 55 then 2 else 0
    }
    if dist_cells <= 6 {
        return if h < 10 + trunk then 1 else if h < 80 then 2 else 3
    }
    if h < 6 + trunk then 1 else if h < 60 then 2 else 3
}

/// A variant for a cell's texture, in `[0, n)`.
pub fn variant(seed: int, row: int, col: int, n: int) -> int {
    hash(seed + 31, col, row, n)
}

/// Whether a path cell carries a mark (one cell in `density` does).
pub fn path_marked(seed: int, row: int, col: int, density: int) -> bool {
    hash(seed + 17, row, col, density) == 0
}
