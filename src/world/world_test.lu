//! The world is a pure function of the seed: the same answers twice, in
//! range, different seeds different forests, the density's bands.

fn test_deterministic() {
    var r = 0
    while r < 200 {
        assert(forest_kind(42, r, 7, 4, 128) == forest_kind(42, r, 7, 4, 128), "kind {r}")
        assert(density(42, r) == density(42, r), "density {r}")
        assert(noise(42, 1, r) == noise(42, 1, r), "noise {r}")
        r += 1
    }
}

fn test_seeds_differ() {
    var same = 0
    var r = 0
    while r < 100 {
        if noise(1, 1, r) == noise(2, 1, r) {
            same += 1
        }
        r += 1
    }
    assert(same < 10, "two seeds share {same} of 100 noise values")
}

fn test_noise_bounds_and_continuity() {
    var prev = -1
    var r = -100
    while r < 500 {
        let n = noise(3, 1, r)
        assert(n >= 0 && n <= FP, "noise {n} at {r}")
        if prev >= 0 {
            let d = if n > prev then n - prev else prev - n
            // Smoothstep's steepest slope is 1.5 of the swing over a lattice.
            assert(d <= FP * 3 / (2 * LATTICE) + 2, "a step of {d} at {r}")
        }
        prev = n
        r += 1
    }
}

fn test_forest_density_rises() {
    var near = 0
    var far = 0
    var i = 0
    while i < 1000 {
        if forest_kind(5, i, 3, 1, 128) == 3 {
            near += 1
        }
        if forest_kind(5, i, 3, 9, 128) == 3 {
            far += 1
        }
        i += 1
    }
    assert(near == 0 && far > 300, "deep forest near {near}, far {far}")
    assert(forest_kind(5, 1, 1, 0, 128) == 0, "the verge is grass")
}

fn test_clearing_reads_and_a_stand_is_the_woods_with_more_trunks() {
    // Over a thousand cells two cells into the forest: a clearing is
    // mostly grass; thin woods and a dense stand draw ONE foliage texture
    // (the maintainer's word, 2026-10-25: the stand's own striped texture
    // is retired, the starting texture kept for the run), the stand told
    // by its trunks alone.
    var grass_clear = 0
    var canopy_stand = 0
    var canopy_woods = 0
    var trunk_stand = 0
    var trunk_woods = 0
    var i = 0
    while i < 1000 {
        if forest_kind(5, i, 3, 2, 0) == 0 {
            grass_clear += 1
        }
        let stand = forest_kind(5, i, 3, 2, FP)
        let woods = forest_kind(5, i, 3, 2, 128)
        if stand == 2 {
            canopy_stand += 1
        }
        if woods == 2 {
            canopy_woods += 1
        }
        if stand == 1 {
            trunk_stand += 1
        }
        if woods == 1 {
            trunk_woods += 1
        }
        i += 1
    }
    assert(grass_clear > 850, "a clearing is grass: {grass_clear}")
    assert(canopy_woods > 300, "the woods are canopy and grass: {canopy_woods}")
    assert(
        canopy_stand > 300 && canopy_stand <= canopy_woods,
        "a stand keeps the woods' canopy: {canopy_stand}",
    )
    assert(trunk_stand > trunk_woods, "a stand has more trunks: {trunk_stand} over {trunk_woods}")
    // Deep forest never within two cells of the path, even in a stand.
    assert(forest_kind(5, 1, 1, 2, FP) != 3, "no deep forest at the verge")
}

fn test_density_bands_are_ordered() {
    var clearing = -1
    var stand = -1
    var r = 0
    while r < 5000 && (clearing < 0 || stand < 0) {
        let b = density_band(7, r)
        if b == 0 && clearing < 0 {
            clearing = r
        }
        if b == 2 && stand < 0 {
            stand = r
        }
        r += LATTICE
    }
    assert(clearing >= 0 && stand >= 0, "seed 7 has a clearing ({clearing}) and a stand ({stand})")
    assert(density(7, clearing) < DENSITY_CLEARING, "a clearing is under the clearing line")
    assert(density(7, stand) >= DENSITY_STAND, "a stand is at the stand line or above")
    assert(density(7, clearing) < density(7, stand), "density ordered")
}

fn test_hash_range() {
    var i = 0
    while i < 500 {
        let h = hash(9, i, i * 3, 7)
        assert(h >= 0 && h < 7, "hash {h}")
        assert(variant(9, i, i * 3, 4) >= 0 && variant(9, i, i * 3, 4) < 4, "variant")
        i += 1
    }
    var marked = 0
    i = 0
    while i < 900 {
        if path_marked(9, i / 30, i % 30, 9) {
            marked += 1
        }
        i += 1
    }
    assert(marked > 50 && marked < 150, "about one cell in nine carries a mark: {marked}")
}
