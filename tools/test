#!/bin/sh
# test — the unit tests: `wolf test --deny-warnings --nocapture src`, every
# `test_*` on the checked machine (every allocation modelled, every UB row
# detected); in a game that is the game's tests and the pinned engine's,
# through the symlinked module directories. The exit is wolf test's own,
# read directly (never through a pipe); the log is kept in target/test.log,
# and a SKIP line, were one printed, shows under --nocapture and is counted.
set -eu
LAIR_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export LAIR_ROOT
. "$LAIR_ROOT/tools/lib-root.sh"
cd "$GAME_ROOT"
. "$LAIR_ROOT/tools/lib-mem.sh"
require_memory
. "$LAIR_ROOT/tools/lib-toolchain.sh"
mkdir -p target
set +e
"$WOLF" test --deny-warnings --nocapture src >target/test.log 2>&1
status=$?
set -e
cat target/test.log
[ "$status" = 0 ] || exit "$status"
skips=$(grep -c '^SKIP' target/test.log || true)
echo "test: $skips SKIP lines"
[ "$skips" = 0 ]
