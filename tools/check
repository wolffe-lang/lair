#!/bin/sh
# check — everything a pull request must pass, in order, each exit read
# directly: fmt, the unit tests, both builds, the shipped binary's
# selftest; and for a game the goldens and the pty rows. The same list
# runs inside the Linux container as tools/check-linux.
set -eu
LAIR_ROOT=$(cd "$(dirname "$0")/.." && pwd)
export LAIR_ROOT
. "$LAIR_ROOT/tools/lib-root.sh"
cd "$GAME_ROOT"
"$LAIR_ROOT/tools/check-fmt"
"$LAIR_ROOT/tools/test"
"$LAIR_ROOT/tools/build" --all
if [ "$GAME_ROOT" = "$LAIR_ROOT" ]; then
    python3 -I "$LAIR_ROOT/tools/sound-check"
    python3 -I "$LAIR_ROOT/tools/input-check"
    "target/native/$GAME" --selftest
fi
"target/release/$GAME" --selftest
if [ "$GAME_ROOT" != "$LAIR_ROOT" ]; then
    "$LAIR_ROOT/tools/goldens"
    python3 -I "$LAIR_ROOT/tools/pty" --bin "target/release/$GAME"
fi
echo "check: green"
